{
  "name": "handwritten-annotation",
  "version": "0.1.0",
  "description": "Write by hand on PDFs and images embedded in your Obsidian notes.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "pdfjs-dist": "5.3.31",
    "typescript": "7.0.2"
  }
}
