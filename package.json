{
  "name": "handwritten-annotation",
  "version": "0.1.0",
  "description": "Write by hand on PDFs and images embedded in your Obsidian notes.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "pdfjs-dist": "5.3.31",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
